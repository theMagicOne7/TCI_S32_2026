# ETAPA 1: Construcción (Build)
FROM node:20-alpine AS build

WORKDIR /app

# Instalamos pnpm versión 9 globalmente de forma directa (evita fallos de Corepack)
RUN npm install -g pnpm@9

# Copiamos manifiestos de dependencias y configuración de workspace
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* ./

# Instalamos dependencias
RUN pnpm install

# Copiamos el resto del código y construimos la versión de producción
COPY . .
RUN pnpm run build

# ETAPA 2: Servidor Web (Nginx)
FROM nginx:alpine

# Copiamos la carpeta dist generada al directorio público de Nginx
COPY --from=build /app/dist /usr/share/nginx/html

# Copiamos la configuración de Nginx para SPA
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]